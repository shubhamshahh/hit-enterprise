# Copy this file to .env and fill in your own values before deploying.

# Port the server listens on (most hosts set this automatically)
PORT=3000

# Admin credentials for /admin.html
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345

# -------------------------------------------------------------
# SUPABASE DATABASE & PERMANENT IMAGE STORAGE (RECOMMENDED)
# -------------------------------------------------------------
# Enables permanent data safety, cloud PostgreSQL, and Supabase Storage CDN.
# When configured, chemical images uploaded from Admin are saved permanently
# in Supabase Storage ('product-images' bucket) and served via global CDN to users.
#
# Find these in Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role secret key for full backend access:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# (Optional fallback if service_role key is not used)
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- WhatsApp notifications for new chemical requests (optional) ---
# Uses CallMeBot (free, no business account needed). Setup:
#   1. Save +34 644 59 71 45 as a contact on your phone
#   2. WhatsApp it: "I allow callmebot to send me messages"
#   3. It replies with an API key — put it below
WHATSAPP_NOTIFY_ENABLED=false
WHATSAPP_PHONE=918849019883
WHATSAPP_APIKEY=your-callmebot-api-key
