# Copy this file to .env and fill in your own values before deploying.

# Port the server listens on (most hosts set this automatically)
PORT=3000

# Password required to view/manage quote requests at /admin.html
# CHANGE THIS before deploying publicly.
ADMIN_PASSWORD=12345

# Contact details shown on the site can also be overridden here later if
# you wire them through the API instead of editing public/index.html directly.

# --- WhatsApp notifications for new chemical requests (optional) ---
# Uses CallMeBot (free, no business account needed). Setup:
#   1. Save +34 644 59 71 45 as a contact on your phone
#   2. WhatsApp it: "I allow callmebot to send me messages"
#   3. It replies with an API key — put it below
WHATSAPP_NOTIFY_ENABLED=false
WHATSAPP_PHONE=918849019883
WHATSAPP_APIKEY=your-callmebot-api-key
